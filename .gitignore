.env
.env.*
!.env.example
secrets/

# IDEs and editors
/.idea
.project
.classpath
.c9/
*.launch
.settings/
*.sublime-workspace

# IDE - VSCode
.vscode/*
!.vscode/settings.json
!.vscode/tasks.json
!.vscode/launch.json
!.vscode/extensions.json

# misc
/.sass-cache
/connect.lock
/coverage
/libpeerconnection.log
npm-debug.log
yarn-error.log
testem.log
/typings

# System Files
.DS_Store
Thumbs.db

.nx/cache
.nx/workspace-data
.nx/migrate-runs
.claude/worktrees
.claude/settings.local.json

.angular

# Lean-Agile MVP project state (ADR-017, ADR-022), mirroring lean-agile-os.
#
# 🔴 The split is deliberate and load-bearing. `project.json` IS tracked: being a project is a fact
# about the repository and should survive a clone. Everything else under `.mvp/` is app state and
# must NOT be — tracking it would make the state branch-scoped, reintroducing for the state exactly
# the defect ADR-022 exists to remove for the register.
.mvp/*
!.mvp/project.json
